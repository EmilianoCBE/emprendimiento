# Copia este archivo como .env. Nunca subas .env al repositorio.
NODE_ENV=development
PORT=4000
# Vacío = PGlite local en apps/api/.data. Para Supabase: cadena del Session pooler.
DATABASE_URL=
# Genera con: openssl rand -hex 32  (obligatorio en producción)
APP_SECRET=
# Origen público de la web
PUBLIC_ORIGIN=http://localhost:5173
# Crea cuentas y datos ficticios y muestra códigos en pantalla. Prohibido en producción.
DEMO_MODE=true
INSTITUTIONAL_DOMAINS=tec.mx,itesm.mx
# Demo en internet: base en memoria y contraseña compartida (usuario: equipo). Incompatible con DATABASE_URL.
# PUBLIC_DEMO=true
# DEMO_ACCESS_PASSWORD=
# Producción con Supabase: ruta al certificado CA que se descarga de su panel.
# DATABASE_CA_CERT=/etc/ssl/supabase-ca.crt
# Solo si hay un proxy inverso delante; sin esto, los límites por IP verían siempre al proxy.
# TRUST_PROXY=true
